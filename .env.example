PORT=8080
OPENAI_API_KEY=sk-xxxx
SOURCE_URL=srt://belabox-ip:port
CHUNK_FLUSH_MS=2000
SILENCE_THRESHOLD=0.015
# Optional rate limits (defaults: 60/min, 3600/hour)
MAX_TRANSCRIPTIONS_PER_MINUTE=60
MAX_TRANSCRIPTIONS_PER_HOUR=3600
TRANSCRIBER_PROVIDER=openai-whisper
# Set to enable translation (e.g. "Spanish", "fr-FR")
TRANSLATION_TARGET=
TRANSLATOR_PROVIDER=openai

# Kick integration
KICK_CLIENT_ID=
KICK_CLIENT_SECRET=
